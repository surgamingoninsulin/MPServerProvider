# ---- App runtime data (servers, mods, caches, user settings) -----------------
# The dev build keeps all runtime data in dotnet/data; never commit it.
dotnet/data/
# User settings written by the app at runtime.
data/settings.json
# Downloaded/cached runtime files anywhere under a data folder.
**/data/cache/
**/data/servers/
**/data/mods/
**/data/tools/
**/data/tunnel/

