<Window x:Class="MPServerProvider.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MP Server Provider"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource RootBackgroundBrush}">
    <!-- Borderless custom-chrome shell. WindowChrome gives us the
         real resize/snap behavior of a normal window while WindowStyle=None removes the native
         titlebar, so the top bar below supplies its own drag region (CaptionHeight) plus custom
         minimize/maximize/close buttons (_ / □ / ✕ in the reference screenshots' top-right). -->
    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: brand / nav pills / chrome buttons, matching views_mainwindow.xaml's three
             StackPanels in one Grid row. MouseDown drag is wired in code-behind so this whole
             row (minus the buttons) acts as the draggable titlebar region. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource SidebarBackgroundBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock FontSize="15" FontWeight="Bold">
                    <Run Text="MP SERVER" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Run Text=" PROVIDER" Foreground="{StaticResource BrandAccentBrush}" />
                </TextBlock>
                <TextBlock Text="L O C A L   G A M E   S E R V E R   P A N E L"
                           FontSize="9" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>

            <StackPanel x:Name="Nav" Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <RadioButton x:Name="NavHome" Style="{StaticResource NavPillStyle}" GroupName="nav"
                             IsChecked="True" Tag="home" Checked="NavButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" Style="{StaticResource IconTextStyle}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Home" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavLibrary" Style="{StaticResource NavPillStyle}" GroupName="nav"
                             Tag="library" Checked="NavButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource IconTextStyle}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Library" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavMods" Style="{StaticResource NavPillStyle}" GroupName="nav"
                             Tag="mods" Checked="NavButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA86;" Style="{StaticResource IconTextStyle}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Mods" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavServers" Style="{StaticResource NavPillStyle}" GroupName="nav"
                             Tag="servers" Checked="NavButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource IconTextStyle}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="My Servers" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavPillStyle}" GroupName="nav"
                             Tag="settings" Checked="NavButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource IconTextStyle}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Style="{StaticResource ChromeButtonStyle}" Click="Minimize_Click"
                        ToolTip="Minimize">
                    <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                </Button>
                <Button x:Name="MaxRestoreButton" Style="{StaticResource ChromeButtonStyle}" Click="MaxRestore_Click">
                    <TextBlock Text="&#xE739;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                </Button>
                <Button Style="{StaticResource ChromeCloseButtonStyle}" Click="Close_Click">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Page host: swaps between the 5 page UserControls by selected nav pill. -->
        <ContentControl x:Name="PageHost" Grid.Row="1" />

        <!-- Toast overlay: bottom-right stack bound to ToastService.Toasts. -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,20,20" IsHitTestVisible="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ToastCardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFontFamily}"
                                       Foreground="{StaticResource BrandAccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Shown while the app waits for running servers to save and stop before closing. -->
        <Grid x:Name="ShutdownOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Background="{StaticResource RootBackgroundBrush}" Opacity="0.85" />
            <Border Style="{StaticResource CardStyle}" Padding="28,24" MinWidth="380" MaxWidth="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource BrandAccentDarkBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Stopping servers…" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="ShutdownDetailText" Margin="0,8,0,16" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="Giving your servers time to save their worlds before MP Server Provider closes." />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,16"
                                 Foreground="{StaticResource BrandAccentBrush}" Background="{StaticResource PanelBackgroundBrush}"
                                 BorderThickness="0" />
                    <Button x:Name="ForceQuitButton" Content="Force Quit" HorizontalAlignment="Right"
                            Style="{StaticResource DangerButtonStyle}" Click="ForceQuit_Click"
                            ToolTip="Kill the servers now — unsaved progress may be lost" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
