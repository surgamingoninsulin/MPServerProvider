<local:DialogWindow x:Class="MPServerProvider.App.Views.Dialogs.UpdateServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MPServerProvider.App.Views.Dialogs"
        Title="Update Server" Width="460" SizeToContent="Height">
    <!-- Pick a version -> InstallService.UpdateAsync re-runs the game's installer into the
         server's own folder (worlds, mods and config files are kept), with a live progress bar. -->
    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock x:Name="CurrentText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" x:Name="VersionPanel">
            <TextBlock Text="Update to" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
            <ComboBox x:Name="VersionCombo" />
            <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Worlds, mods and server config files (server.properties, server.cfg, allowlists…) are kept." />
        </StackPanel>

        <StackPanel Grid.Row="2" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
            <TextBlock x:Name="ProgressStatusText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                       Margin="0,0,0,6" TextWrapping="Wrap" />
            <ProgressBar x:Name="ProgressBarControl" Height="6" Minimum="0" Maximum="100" BorderThickness="0"
                         Foreground="{StaticResource BrandAccentBrush}" Background="{StaticResource PanelBackgroundBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button x:Name="UpdateButton" Content="Update" Style="{StaticResource AccentButtonStyle}" IsDefault="True"
                    IsEnabled="False" Click="UpdateButton_Click" />
        </StackPanel>
    </Grid>
</local:DialogWindow>
