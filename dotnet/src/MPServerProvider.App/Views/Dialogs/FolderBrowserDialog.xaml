<local:DialogWindow x:Class="MPServerProvider.App.Views.Dialogs.FolderBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MPServerProvider.App.Views.Dialogs"
        Title="Select Folder" Width="820" Height="560">
    <!-- In-app folder picker (themed, replaces the Windows folder dialog): drives and quick places
         on the left, the current folder's subfolders on the right. Folders are listed on a worker
         thread; hidden/system folders and junctions/symlinks are not shown. -->
    <local:DialogWindow.Resources>
        <Style x:Key="BrowserListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,5" Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type local:FolderEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" Style="{StaticResource IconTextStyle}" FontSize="14" Width="20"
                           Margin="0,0,8,0" Foreground="{StaticResource BrandAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </local:DialogWindow.Resources>

    <Grid Margin="20,14,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

        <!-- Path bar -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Style="{StaticResource GhostButtonStyle}" Padding="10,6" ToolTip="Up one folder"
                    AutomationProperties.Name="Up one folder" Click="UpButton_Click">
                <TextBlock Text="&#xE74A;" Style="{StaticResource IconTextStyle}" FontSize="12" />
            </Button>
            <TextBox x:Name="PathBox" Grid.Column="1" Margin="8,0" KeyDown="PathBox_KeyDown"
                     AutomationProperties.Name="Folder path" ToolTip="Type or paste a folder path and press Enter" />
            <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Padding="10,6" ToolTip="Refresh"
                    AutomationProperties.Name="Refresh" Click="RefreshButton_Click">
                <TextBlock Text="&#xE72C;" Style="{StaticResource IconTextStyle}" FontSize="12" />
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="8" Padding="4">
                <ListBox x:Name="PlacesList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource BrowserListItemStyle}" ItemTemplate="{StaticResource EntryTemplate}"
                         SelectionChanged="PlacesList_SelectionChanged" AutomationProperties.Name="Drives and places" />
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="8" Padding="4">
                <Grid>
                    <ListBox x:Name="FoldersList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ItemContainerStyle="{StaticResource BrowserListItemStyle}" ItemTemplate="{StaticResource EntryTemplate}"
                             MouseDoubleClick="FoldersList_MouseDoubleClick" KeyDown="FoldersList_KeyDown"
                             SelectionChanged="FoldersList_SelectionChanged" AutomationProperties.Name="Folders" />
                    <TextBlock x:Name="ListStatusText" Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="20" IsHitTestVisible="False" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Selected folder" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                <TextBlock x:Name="SelectedText" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0" Click="CancelButton_Click" />
                <Button x:Name="SelectButton" Content="Select this folder" Style="{StaticResource AccentButtonStyle}" Click="SelectButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</local:DialogWindow>
