<local:DialogWindow x:Class="MPServerProvider.App.Views.Dialogs.InstallChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MPServerProvider.App.Views.Dialogs"
        Title="Add Server" Width="620" SizeToContent="Height">
    <!-- First step of "Install": a fresh install, or import a server folder that already exists.
         The cards are Buttons, so keyboard (Tab/Enter) and UI Automation work out of the box. -->
    <local:DialogWindow.Resources>
        <Style x:Key="ChoiceCardStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" Padding="20,22">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandAccentBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:DialogWindow.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Start a brand-new server, or bring in one you already have."
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="NewCard" Grid.Column="0" Style="{StaticResource ChoiceCardStyle}" Click="NewCard_Click"
                    AutomationProperties.Name="Install new server">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource BrandAccentDarkBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE896;" Style="{StaticResource IconTextStyle}" FontSize="20"
                                   Foreground="{StaticResource BrandAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Install new server" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="NewText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <Button x:Name="ImportCard" Grid.Column="2" Style="{StaticResource ChoiceCardStyle}" Click="ImportCard_Click"
                    AutomationProperties.Name="Import existing server">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource BrandAccentDarkBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextStyle}" FontSize="20"
                                   Foreground="{StaticResource BrandAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Import existing server" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="ImportText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}" IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</local:DialogWindow>
