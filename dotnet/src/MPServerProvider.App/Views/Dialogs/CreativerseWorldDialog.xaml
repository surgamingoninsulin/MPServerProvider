<local:DialogWindow x:Class="MPServerProvider.App.Views.Dialogs.CreativerseWorldDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MPServerProvider.App.Views.Dialogs"
        Title="Creativerse World"
        Width="472" SizeToContent="Height">
    <!-- Shown before a Creativerse server starts when its config_world.json is missing or has
         no owner. Chrome comes from DialogWindow. -->
    <StackPanel Margin="24,18,24,24">
        <TextBlock Text="Set up the Creativerse world" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" TextWrapping="Wrap"
                   Text="The Creativerse server can't create its own world settings. Fill these in once and the app writes config_world.json for you (public world, you as owner)." />

        <TextBlock Text="Your SteamID64 (world owner)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SteamIdBox" MaxLength="17" />
            <Button Grid.Column="1" Content="Find my ID" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Click="FindIdButton_Click" />
        </Grid>

        <TextBlock Text="World name" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
        <TextBox x:Name="WorldNameBox" Margin="0,0,0,12" />

        <TextBlock Text="World template" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="TemplateCombo" IsEditable="True" />
            <Button x:Name="ImportZipButton" Grid.Column="1" Content="Import from .zip…" Margin="8,0,0,0"
                    Style="{StaticResource GhostButtonStyle}" Click="ImportZipButton_Click" />
        </Grid>
        <TextBlock Text="Downloaded a world from mod.io (mod.io/g/creativerse/m)? Import its .zip here instead of typing a key."
                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBlock x:Name="TemplateHint" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,0,8"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Cancel" Width="90" Style="{StaticResource GhostButtonStyle}" Click="CancelButton_Click" />
            <Button Content="Save &amp; Start" Width="120" Margin="10,0,0,0" IsDefault="True"
                    Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click" />
        </StackPanel>
    </StackPanel>
</local:DialogWindow>
