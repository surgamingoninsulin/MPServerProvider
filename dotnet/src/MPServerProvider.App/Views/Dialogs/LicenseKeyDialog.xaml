<local:DialogWindow x:Class="MPServerProvider.App.Views.Dialogs.LicenseKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MPServerProvider.App.Views.Dialogs"
        xmlns:conv="clr-namespace:MPServerProvider.App.Converters"
        Title="Cfx.re Licence Key"
        Width="452" SizeToContent="Height">
    <Window.Resources>
        <conv:IntZeroToVisibilityConverter x:Key="LengthZeroToVisibility" />
    </Window.Resources>
    <!-- Port of views_licensekeydialog.xaml: a single licence-key field + explanatory note,
         matching the recovered XAML's element tree. Chrome comes from DialogWindow. -->
    <StackPanel Margin="24,18,24,24">
        <TextBlock Text="Licence Key Required" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Text="Cfx.re servers (FiveM/RedM) can't start without a licence key in server.cfg."
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" TextWrapping="Wrap" />

        <TextBlock Text="Licence Key" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
        <Grid Margin="0,0,0,14">
            <TextBox x:Name="KeyBox" />
            <TextBlock Text="cfxk_…" Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                       Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Visibility="{Binding Text.Length, ElementName=KeyBox, Converter={StaticResource LengthZeroToVisibility}}" />
        </Grid>

        <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE946;" Style="{StaticResource IconTextStyle}" Foreground="{StaticResource BrandAccentBrush}"
                           VerticalAlignment="Top" Margin="0,2,8,0" />
                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                    <Run Text="Note:" FontWeight="SemiBold" />
                    <Run Text=" Keys are free — sign in at portal.cfx.re, open Servers → Registered Keys and create one. The key is saved into this server's server.cfg." />
                </TextBlock>
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,0,8"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="Cancel" Width="90" Style="{StaticResource GhostButtonStyle}" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="Save &amp; Start" Width="120" Margin="10,0,0,0" IsDefault="True"
                    Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click" />
        </StackPanel>
    </StackPanel>
</local:DialogWindow>
