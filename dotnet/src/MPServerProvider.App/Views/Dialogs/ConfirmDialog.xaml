<local:DialogWindow x:Class="MPServerProvider.App.Views.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MPServerProvider.App.Views.Dialogs"
        Title="Confirm"
        Width="432" SizeToContent="Height">
    <!--
        Reusable themed confirmation dialog, replacing the native System.Windows.MessageBox
        previously used for "Delete server?" / "Delete file?" prompts. Chrome (rounded card,
        title bar, close button, shadow, drag) comes from DialogWindow / DialogWindowStyle.
    -->
    <StackPanel Margin="24,18,24,24">
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock x:Name="MessageText" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,20" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" Style="{StaticResource GhostButtonStyle}" Click="CancelButton_Click" />
            <Button x:Name="ConfirmButton" MinWidth="110" Margin="10,0,0,0" IsDefault="True" Click="ConfirmButton_Click" />
        </StackPanel>
    </StackPanel>
</local:DialogWindow>
