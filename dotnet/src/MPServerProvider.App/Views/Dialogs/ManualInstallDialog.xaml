<local:DialogWindow x:Class="MPServerProvider.App.Views.Dialogs.ManualInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MPServerProvider.App.Views.Dialogs"
        Title="Create Server" Width="472" SizeToContent="Height">
    <!-- Port of views_manualinstalldialog.xaml: used for "manual"-provider games (no downloadable
         artifact), the user points at an already-extracted server folder on disk; that folder
         path rides through ManualProvider via InstallRequest.Version, mirroring the proven Rust
         reference's dialogs/manual_install.rs. Chrome comes from DialogWindow. -->
    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <TextBlock Text="Server name" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" Margin="0,0,0,12" />

            <TextBlock Text="Port" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="PortBox" Margin="0,0,0,12" />

            <TextBlock Text="Server folder (already contains the server files)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" Grid.Column="0" />
                <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse…" Style="{StaticResource GhostButtonStyle}" Click="BrowseButton_Click" />
            </Grid>

            <TextBlock x:Name="StatusText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button x:Name="InstallButton" Content="Create Server" Style="{StaticResource AccentButtonStyle}" IsDefault="True" Click="InstallButton_Click" />
        </StackPanel>
    </Grid>
</local:DialogWindow>
