<local:DialogWindow x:Class="MPServerProvider.App.Views.Dialogs.AddCustomGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MPServerProvider.App.Views.Dialogs"
        Title="Add Custom Game" Height="700" Width="492">
    <!-- Port of views_addcustomgamedialog.xaml's "Add to Library" flow (OnAddCustomGame):
         builds a GameDefinition from the form and writes it to {GamesDir}/{id}.json, the same
         on-disk shape GameLibraryService.Reload() reads back, then reloads the catalog.
         Chrome comes from DialogWindow; the form scrolls (wheel) while the header and the
         action buttons stay fixed. -->
    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add Custom Game" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Name" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" Margin="0,0,0,12" />

                <TextBlock Text="Game ID (letters, numbers, dashes — auto-filled from name if blank)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBox x:Name="IdBox" Margin="0,0,0,12" />

                <TextBlock Text="Description" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="DescriptionBox" Margin="0,0,0,12" TextWrapping="Wrap" AcceptsReturn="True" Height="58"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Genres (comma-separated)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="GenresBox" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Steam App ID (optional)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="SteamAppIdBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <Button x:Name="FetchSteamInfoButton" Content="Fetch Steam Artwork" Style="{StaticResource GhostButtonStyle}" Click="FetchSteamInfoButton_Click" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Cover image URL or local path" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="ImageUrlBox" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Launch executable" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="ExecutableBox" Text="{}{server_file}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Default port" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="DefaultPortBox" Text="25565" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Launch arguments (optional)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="ArgumentsBox" Margin="0,0,0,4" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource DangerBrush}" FontSize="12"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0" Click="CancelButton_Click" />
                <Button x:Name="AddButton" Content="Add to Library" Style="{StaticResource AccentButtonStyle}" Click="AddButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</local:DialogWindow>
