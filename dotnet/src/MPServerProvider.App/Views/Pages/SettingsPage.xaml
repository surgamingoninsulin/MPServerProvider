<UserControl x:Class="MPServerProvider.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MPServerProvider.App.ViewModels"
             xmlns:conv="clr-namespace:MPServerProvider.App.Converters">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <!-- Port of views_settingspage.xaml: Storage Management / Startup & Behavior / System
         Resources / System Specifications / Firewall Rules, per
         docs/reference-screenshots/6.png and 7.png. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28" MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <!-- Row 9: Firewall Rules. This row was missing, so Grid.Row="9" got clamped
                     into row 8 and the Firewall section drew on top of System Specifications. -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Manage your storage, system resources, and configurations"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Storage Management" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource BrandAccentDarkBrush}">
                                <TextBlock Text="&#xEE94;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                           Foreground="{StaticResource BrandAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Total Disk Usage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{Binding DiskUsageText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding DiskUsageFraction, Mode=OneWay}"
                                     Height="6" Margin="0,12,0,4" Foreground="{StaticResource BrandAccentBrush}"
                                     Background="{StaticResource PanelBackgroundBrush}" BorderThickness="0" />
                        <TextBlock Grid.Row="2" Text="{Binding DiskUsageCaption}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource BrandAccentDarkBrush}">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                           Foreground="{StaticResource BrandAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Game Files" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{Binding GameFilesText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding GameFilesFraction, Mode=OneWay}"
                                     Height="6" Margin="0,12,0,4" Foreground="{StaticResource BrandAccentBrush}"
                                     Background="{StaticResource PanelBackgroundBrush}" BorderThickness="0" />
                        <TextBlock Grid.Row="2" Text="{Binding GameFilesCaption}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xEDA2;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Installation Drive" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="Choose where to install new game servers" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="2" x:Name="DriveCombo" Width="220"
                                  ItemsSource="{Binding DriveLabels}"
                                  SelectedIndex="{Binding SelectedDriveIndex, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding InstallPathText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="4" Text="Startup &amp; Behavior" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
            <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <CheckBox Content="Launch panel automatically when I log in" Margin="0,4"
                              Foreground="{StaticResource TextPrimaryBrush}" IsChecked="{Binding StartOnBoot, Mode=TwoWay}" />
                    <CheckBox Content="Start minimized to system tray" Margin="0,4"
                              Foreground="{StaticResource TextPrimaryBrush}" IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                              IsEnabled="{Binding StartOnBoot}" />
                    <CheckBox Content="Restart servers that were running on last shutdown" Margin="0,4"
                              Foreground="{StaticResource TextPrimaryBrush}" IsChecked="{Binding RestoreServers, Mode=TwoWay}"
                              ToolTip="On launch, automatically starts any server that was running when the panel was closed" />
                    <CheckBox Content="Slide the Home news cards automatically" Margin="0,4"
                              Foreground="{StaticResource TextPrimaryBrush}" IsChecked="{Binding NewsAutoScroll, Mode=TwoWay}"
                              ToolTip="Continuously scrolls the news row from right to left, looping back to the first card. Pauses while the mouse is over it." />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="6" Text="System Resources" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
            <Grid Grid.Row="7" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="8" Background="#1C3A1F">
                                <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                           Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CPU Usage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{Binding CpuText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding CpuFraction, Mode=OneWay}"
                                     Height="6" Margin="0,12,0,0" Foreground="{StaticResource BrandAccentBrush}"
                                     Background="{StaticResource PanelBackgroundBrush}" BorderThickness="0" />
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="8" Background="#4A3414">
                                <TextBlock Text="&#xE964;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                           Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="RAM Usage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{Binding RamText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding RamFraction, Mode=OneWay}"
                                     Height="6" Margin="0,12,0,0" Foreground="{StaticResource BrandAccentBrush}"
                                     Background="{StaticResource PanelBackgroundBrush}" BorderThickness="0" />
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="8" Background="{StaticResource BrandAccentDarkBrush}">
                                <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFontFamily}" FontSize="18"
                                           Foreground="{StaticResource BrandAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Active Servers" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Text="{Binding ActiveServersText}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="0"
                                     Height="6" Margin="0,12,0,0" Foreground="{StaticResource BrandAccentBrush}"
                                     Background="{StaticResource PanelBackgroundBrush}" BorderThickness="0" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="8" Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="System Specifications" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Processor" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding SpecCpu}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <TextBlock Text="Memory" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding SpecRam}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Graphics" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding SpecGpu}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="Operating System" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBlock Text="{Binding SpecOs}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="9" Margin="0,0,0,28">
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Firewall Rules" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left" />
                    <Button Content="Add Rule" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"
                            Padding="14,6" Click="AddRuleButton_Click" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FirewallRuleViewModel}">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#1C3A1F" Margin="0,0,12,0">
                                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                                   Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding DetailText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource ChromeButtonStyle}"
                                            Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFontFamily}" Foreground="{StaticResource DangerBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No firewall rules created by the panel yet." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"
                           Visibility="{Binding NoRules, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
