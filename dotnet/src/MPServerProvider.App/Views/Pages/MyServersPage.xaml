<UserControl x:Class="MPServerProvider.App.Views.Pages.MyServersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MPServerProvider.App.ViewModels"
             xmlns:views="clr-namespace:MPServerProvider.App.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Background="{StaticResource RootBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left sidebar: server list + Connect to Tunnel / Import Server Config -->
        <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource CardBackgroundBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,20,16,8">
                    <TextBlock Text="YOUR SERVERS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ActiveCountText}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,2,0,12" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Search servers..." />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" x:Name="ServerList"
                             ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"
                             Background="Transparent" BorderThickness="0" Margin="8,0,8,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowBorder" CornerRadius="8" Padding="12,10" Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BrandAccentDarkBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ServerRowViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Margin="16">
                        <Button Style="{StaticResource AccentButtonStyle}" AutomationProperties.Name="Connect to Tunnel"
                                HorizontalContentAlignment="Center" Command="{Binding ConnectTunnelCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Connect to Tunnel" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButtonStyle}" AutomationProperties.Name="Import Server Config"
                                HorizontalContentAlignment="Center" Margin="0,8,0,0"
                                Command="{Binding ImportServerConfigCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Import Server Config" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Right side: empty state or server detail -->
        <Grid Grid.Column="1">
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAnyServers}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BrandAccentDarkBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26"
                               Foreground="{StaticResource BrandAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No Servers Yet" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="Create your first server from the " />
                    <Hyperlink Click="LibraryLink_Click" TextDecorations="{x:Null}">
                        <Run Text="Library" Foreground="{StaticResource BrandAccentBrush}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <ContentControl x:Name="DetailHost">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <views:ServerDetailView DataContext="{Binding Detail}" />
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
