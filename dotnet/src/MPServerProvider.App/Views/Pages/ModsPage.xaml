<UserControl x:Class="MPServerProvider.App.Views.Pages.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MPServerProvider.App.ViewModels"
             xmlns:conv="clr-namespace:MPServerProvider.App.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVisibility" />
    </UserControl.Resources>
    <!-- "Show:" game dropdown + Import from Folder toolbar, scrollable
         mod card list / empty state, and a right-hand "Filters" sidebar (keyword box + per-game
         checkboxes), per docs/reference-screenshots/3.png. -->
    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="DropArea" Grid.Column="0" Margin="0,0,20,0" AllowDrop="True" Background="Transparent"
              DragEnter="Drop_DragOver" DragOver="Drop_DragOver" DragLeave="Drop_DragLeave" Drop="Drop_Drop">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Mod &amp; Plugin Manager" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Import mods and plugins from a local folder and assign them to your servers — free, no store, no accounts"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Show:" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="GameFilterCombo" Grid.Column="1" HorizontalAlignment="Left" Width="240"
                          ItemsSource="{Binding GameFilterNames}"
                          SelectedIndex="{Binding SelectedGameIndex, Mode=TwoWay}" />
                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding ImportFromFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8DE;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Import from Folder" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <!-- Virtualized (only visible cards are realized) with pixel scrolling; the card
                     list is diffed in place by the view model, so refreshes keep the scroll offset. -->
                <ItemsControl ItemsSource="{Binding Cards}"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModCardViewModel}">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                                                Background="{StaticResource BrandAccentDarkBrush}" Margin="0,0,14,0">
                                            <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                       Foreground="{StaticResource BrandAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0">
                                                <Run Text="{Binding GameName, Mode=OneWay}" />
                                                <Run Text="  •  " />
                                                <Run Text="{Binding DetailText, Mode=OneWay}" />
                                            </TextBlock>
                                            <!-- Jar metadata tags: "MC 1.21.1 · Fabric", "Needs Fabric API"… -->
                                            <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,0" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type sys:String}">
                                                        <Border Background="{StaticResource BrandAccentDarkBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,6,2">
                                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource BrandAccentBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Warning}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{StaticResource DangerBrush}"
                                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                            <ItemsControl ItemsSource="{Binding AssignedServers}" Margin="0,6,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type sys:String}">
                                                        <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" Padding="8,3" Margin="0,0,6,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}"
                                                                        Padding="4,0,0,0" Cursor="Hand" Margin="4,0,0,0"
                                                                        Click="RemoveAssignmentButton_Click" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                                                Click="AddToServerButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Add to Server" FontSize="12" />
                                                <TextBlock Text=" ▾" FontSize="12" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="3" Style="{StaticResource ChromeButtonStyle}"
                                                Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource DangerBrush}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource PanelBackgroundBrush}">
                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,4" />
                    <TextBlock Text="{Binding EmptyText}"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Or drag mod/plugin files from Explorer onto this page."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <!-- Drag-and-drop overlay (files from Explorer → library for the selected game). -->
            <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" IsHitTestVisible="False"
                    CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource BrandAccentBrush}" Background="#D90B1020">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{StaticResource BrandAccentBrush}" />
                    <TextBlock x:Name="DropOverlayTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#990B1020" CornerRadius="8"
                    Visibility="{Binding IsImportingDrop, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Importing…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>
        </Grid>

        <Border Grid.Column="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding FilterSummary}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Button Content="Reset" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource BrandAccentBrush}" Cursor="Hand"
                            Command="{Binding ResetFiltersCommand}" />
                </Grid>

                <Grid Margin="0,14,0,0">
                    <TextBox x:Name="KeywordBox" Tag="Keywords"
                             Text="{Binding Keyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <TextBlock Text="Game" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6" />
                <ItemsControl ItemsSource="{Binding GameChecks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GameCheckOption}">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
