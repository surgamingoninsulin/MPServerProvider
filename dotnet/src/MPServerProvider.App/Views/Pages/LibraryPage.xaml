<UserControl x:Class="MPServerProvider.App.Views.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Port of views_librarypage.xaml (SearchBox/GenreChips/CardsHost/CountText), real data:
         search box + genre filter pills + a real game-card grid from AppServices.Games.All(),
         cover art loaded async via AppServices.Artwork, "+ Add Custom Game" opens
         AddCustomGameDialog, each card's Install button opens InstallServerDialog/
         ManualInstallDialog. Genre pills and cards are built in code-behind (LibraryPage.xaml.cs)
         since their count/content is fully data-driven. -->
    <Grid Margin="28,24,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Game Library" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Browse and install game servers to run on your PC"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox" Grid.Column="0" Width="360" HorizontalAlignment="Left"
                     TextChanged="SearchBox_TextChanged" Tag="Search for games..." />

            <TextBlock x:Name="CountText" Grid.Column="1" Margin="14,0,0,0"
                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="0 games available" />

            <Button x:Name="AddCustomGameButton" Grid.Column="3" Content="+ Add Custom Game"
                    Style="{StaticResource AccentButtonStyle}" Click="AddCustomGameButton_Click" />
        </Grid>

        <ItemsControl Grid.Row="2" x:Name="GenrePanel" Margin="0,0,0,18">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <ItemsControl x:Name="CardsPanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
