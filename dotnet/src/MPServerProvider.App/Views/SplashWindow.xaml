<Window x:Class="MPServerProvider.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MP Server Provider"
        Width="560" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <!-- Port of views_splashwindow.xaml's element tree: an outer rounded Border (atmospheric
         background + ring/controller glyph), then rows for title/subtitle/status+progress.
         The real background photo asset is unrecoverable (deferred BAML binary); this uses
         SplashBackgroundBrush (a dark radial vignette) as a documented stand-in, per
         docs/reference-screenshots/9.png and 10.png. -->
    <Border Background="{StaticResource SplashBackgroundBrush}"
            CornerRadius="18"
            BorderBrush="{StaticResource BrandAccentDarkBrush}"
            BorderThickness="1">
        <Grid Margin="0,28,0,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Glowing ring + controller glyph, approximated with a Border/Ellipse combo and a
                 DropShadowEffect-based glow rather than the unrecoverable real art asset. -->
            <Grid Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Ellipse Width="128" Height="128" Stroke="{StaticResource BrandAccentBrush}" StrokeThickness="4">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#4F6BFF" BlurRadius="40" ShadowDepth="0" Opacity="0.9" />
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="96" Height="96" Stroke="{StaticResource BrandAccentDarkBrush}" StrokeThickness="2" />
                <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Grid.Row="1" Text="MP SERVER PROVIDER"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />

            <TextBlock Grid.Row="2" Text="Please wait a moment while we prepare your experience."
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />

            <Grid Grid.Row="3" Margin="48,20,48,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Starting…"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Left" />
                <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource BrandAccentBrush}"
                           HorizontalAlignment="Right" />
            </Grid>

            <ProgressBar x:Name="Progress" Grid.Row="4" Margin="48,8,48,0"
                         Height="6" Minimum="0" Maximum="100" Value="0"
                         Foreground="{StaticResource BrandAccentBrush}"
                         Background="{StaticResource PanelBackgroundBrush}"
                         BorderThickness="0" />
        </Grid>
    </Border>
</Window>
