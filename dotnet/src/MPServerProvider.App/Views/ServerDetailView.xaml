<UserControl x:Class="MPServerProvider.App.Views.ServerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MPServerProvider.App.ViewModels"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:tabs="clr-namespace:MPServerProvider.App.Views.ServerTabs"
             xmlns:conv="clr-namespace:MPServerProvider.App.Converters"
             xmlns:controls="clr-namespace:MPServerProvider.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <controls:UrlToBitmapConverter x:Key="UrlToBitmap" />
        <!-- Shown over the File Manager / Mods tab while files are dragged over it. -->
        <Style x:Key="DropOverlayStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandAccentBrush}" />
            <Setter Property="Background" Value="#D90B1020" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,20,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: name / status / game line + action buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding NameText}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding GameText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="▶  Start" Padding="14,8" Command="{Binding StartCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="■  Stop" Padding="14,8" Margin="8,0,0,0" Command="{Binding StopCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                        </Style>
                    </Button.Style>
                </Button>
                <Button Padding="14,8" Margin="8,0,0,0"
                        AutomationProperties.Name="Restart" Command="{Binding RestartCommand}">
                    <Button.Style>
                        <!-- Yellow like the "restarting" status; dark text for contrast on yellow. -->
                        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                            <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                            <Setter Property="Foreground" Value="#1A1405" />
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Restart" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButtonStyle}" Padding="14,8" Margin="8,0,0,0"
                        AutomationProperties.Name="Open Folder" Command="{Binding OpenFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Open Folder" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButtonStyle}" Padding="14,8" Margin="8,0,0,0"
                        AutomationProperties.Name="Export" Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Export" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Padding="14,8" Margin="8,0,0,0"
                        AutomationProperties.Name="Update" ToolTip="Update the server to a newer version (worlds and settings are kept)"
                        Command="{Binding UpdateServerCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Update" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Padding="14,8" Margin="8,0,0,0" AutomationProperties.Name="Delete Server"
                        ToolTip="Delete this server and all of its files" Command="{Binding DeleteServerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Delete" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Tab strip -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="TabConsole" Style="{StaticResource NavPillStyle}" GroupName="detailTab"
                         Content="Console" IsChecked="True" Checked="Tab_Checked" />
            <RadioButton x:Name="TabFiles" Style="{StaticResource NavPillStyle}" GroupName="detailTab"
                         Content="File Manager" Checked="Tab_Checked" Margin="4,0,0,0" />
            <RadioButton x:Name="TabMods" Style="{StaticResource NavPillStyle}" GroupName="detailTab"
                         Content="Mods" Checked="Tab_Checked" Margin="4,0,0,0" />
            <RadioButton x:Name="TabResources" Style="{StaticResource NavPillStyle}" GroupName="detailTab"
                         Content="Resources" Checked="Tab_Checked" Margin="4,0,0,0" />
            <RadioButton x:Name="TabTxAdmin" Style="{StaticResource NavPillStyle}" GroupName="detailTab"
                         Content="txAdmin" Checked="Tab_Checked" Margin="4,0,0,0"
                         Visibility="{Binding IsFiveMOrRedM, Converter={StaticResource BoolToVis}}" />
            <RadioButton x:Name="TabKlei" Style="{StaticResource NavPillStyle}" GroupName="detailTab"
                         Content="Klei Token" Checked="Tab_Checked" Margin="4,0,0,0"
                         Visibility="{Binding IsDontStarve, Converter={StaticResource BoolToVis}}" />
            <RadioButton x:Name="TabResourcePack" Style="{StaticResource NavPillStyle}" GroupName="detailTab"
                         Content="Resource Pack" Checked="Tab_Checked" Margin="4,0,0,0"
                         Visibility="{Binding ResourcePack.IsAvailable, Converter={StaticResource BoolToVis}}" />
            <RadioButton x:Name="TabLuckPerms" Style="{StaticResource NavPillStyle}" GroupName="detailTab"
                         Content="LuckPerms" Checked="Tab_Checked" Margin="4,0,0,0"
                         Visibility="{Binding LuckPerms.IsAvailable, Converter={StaticResource BoolToVis}}" />
            <RadioButton x:Name="TabScenarios" Style="{StaticResource NavPillStyle}" GroupName="detailTab"
                         Content="Scenarios" Checked="Tab_Checked" Margin="4,0,0,0"
                         Visibility="{Binding Scenarios.IsAvailable, Converter={StaticResource BoolToVis}}" />
            <RadioButton x:Name="TabSettings" Style="{StaticResource NavPillStyle}" GroupName="detailTab"
                         Content="Server Settings" Checked="Tab_Checked" Margin="4,0,0,0" />
        </StackPanel>

        <!-- Console: one read-only TextBox fed incrementally by ServerDetailViewModel.ConsoleUpdated
             (append-only, keeps the user's scroll position / selection; auto-follows the end
             only while the view is already scrolled to the bottom). Text is selectable/copyable. -->
        <Grid x:Name="ConsolePanel" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#05070D" CornerRadius="8"
                    BorderBrush="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                <TextBox x:Name="ConsoleBox" Style="{StaticResource CodeEditorTextBoxStyle}"
                         IsReadOnly="True" IsReadOnlyCaretVisible="False" AcceptsTab="False"
                         TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled"
                         Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Padding="12"
                         ScrollViewer.ScrollChanged="ConsoleBox_ScrollChanged" />
            </Border>
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" FontFamily="{StaticResource MonoFontFamily}"
                         Background="{StaticResource CardBackgroundBrush}"
                         Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="CommandBox_KeyDown" />
                <Button Grid.Column="1" Content="Send" Style="{StaticResource AccentButtonStyle}" Width="90" Margin="8,0,0,0"
                        Command="{Binding SendCommandCommand}" />
            </Grid>
        </Grid>

        <!-- File Manager: file list (left) + built-in text editor (right, when a file is open). -->
        <Grid x:Name="FilesPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource GhostButtonStyle}" Padding="10,6"
                        ToolTip="Up one folder" Command="{Binding UpFolderCommand}" IsEnabled="{Binding CanGoUp}">
                    <TextBlock Text="&#xE74A;" Style="{StaticResource IconTextStyle}" FontSize="12" />
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource IconTextStyle}" FontSize="13"
                               Foreground="{StaticResource BrandAccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding FilesPathText}" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentFilesDir}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource GhostButtonStyle}" Padding="10,6"
                        Command="{Binding RefreshFilesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource GhostButtonStyle}" Padding="10,6" Margin="8,0,0,0"
                        Command="{Binding OpenFilesInExplorerCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Open in Explorer" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource GhostButtonStyle}" Padding="10,6" Margin="8,0,0,0"
                        Command="{Binding NewFileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="New File" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FileListColumn" Width="*" />
                    <ColumnDefinition x:Name="EditorColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" AllowDrop="True" Background="Transparent"
                      DragEnter="FilesDrop_DragOver" DragOver="FilesDrop_DragOver" DragLeave="FilesDrop_DragLeave" Drop="FilesDrop_Drop">
                <Border Background="{StaticResource CardBackgroundBrush}" CornerRadius="8" Padding="4">
                    <ListBox x:Name="FilesList" ItemsSource="{Binding Files}" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="FilesList_MouseDoubleClick" KeyDown="FilesList_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,3" Margin="0,1">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FileRowViewModel}">
                                <Grid ToolTip="{Binding OpenToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" Style="{StaticResource IconTextStyle}"
                                               FontSize="14" Width="20" Margin="0,0,8,0">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="{StaticResource TextSecondaryColor}" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" ToolTip="Edit"
                                            Click="EditFile_Click"
                                            Visibility="{Binding IsEditableCandidate, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE70F;" Style="{StaticResource IconTextStyle}" />
                                    </Button>
                                    <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" ToolTip="Delete"
                                            Click="DeleteFile_Click">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconTextStyle}" Foreground="{StaticResource DangerBrush}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border x:Name="FilesDropOverlay" Style="{StaticResource DropOverlayStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE898;" Style="{StaticResource IconTextStyle}" FontSize="30" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrandAccentBrush}" />
                        <TextBlock Text="Drop to copy into this folder" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding FilesPathText}" FontSize="12" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="#990B1020" CornerRadius="8" Visibility="{Binding IsCopyingFiles, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Copying…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>
                </Grid>

                <!-- Built-in editor -->
                <Border x:Name="EditorPanel" Grid.Column="1" Margin="12,0,0,0" Visibility="Collapsed"
                        Background="#05070D" CornerRadius="8"
                        BorderBrush="{StaticResource CardBackgroundBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header: file name + dirty marker + Save / Revert / Close -->
                        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="8,8,0,0" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE8A5;" Style="{StaticResource IconTextStyle}" FontSize="14"
                                           Foreground="{StaticResource BrandAccentBrush}" Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding EditorFileName}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text=" ●" Foreground="{StaticResource WarningBrush}" ToolTip="Unsaved changes"
                                                   Visibility="{Binding IsEditorDirty, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding EditorRelativePath}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource AccentButtonStyle}" Padding="12,6" Click="SaveEditor_Click"
                                            ToolTip="Save (Ctrl+S)" IsEnabled="{Binding IsEditorDirty}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Save" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource GhostButtonStyle}" Padding="12,6" Margin="8,0,0,0"
                                            Command="{Binding RevertEditorCommand}" ToolTip="Discard changes and reload from disk">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7A7;" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="0,0,6,0" />
                                            <TextBlock Text="Revert" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0" ToolTip="Close editor"
                                            Command="{Binding CloseEditorCommand}">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource IconTextStyle}" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Gutter (line numbers, only the visible range) + editor -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Canvas x:Name="GutterCanvas" Grid.Column="0" Width="52" ClipToBounds="True" Background="#0A0E18">
                                <TextBlock x:Name="GutterText" Width="40" TextAlignment="Right"
                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           LineStackingStrategy="BlockLineHeight" />
                            </Canvas>
                            <TextBox x:Name="EditorBox" Grid.Column="1" Style="{StaticResource CodeEditorTextBoxStyle}"
                                     Padding="8,6,8,6"
                                     TextChanged="EditorBox_TextChanged"
                                     PreviewKeyDown="EditorBox_PreviewKeyDown"
                                     ScrollViewer.ScrollChanged="EditorBox_ScrollChanged"
                                     SizeChanged="EditorBox_SizeChanged" />
                        </Grid>

                        <!-- Status line -->
                        <Border Grid.Row="2" BorderBrush="{StaticResource CardBackgroundBrush}" BorderThickness="0,1,0,0" Padding="12,5">
                            <Grid>
                                <TextBlock Text="{Binding EditorInfoText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock x:Name="CaretPositionText" HorizontalAlignment="Right" FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Mods -->
        <Grid x:Name="ModsPanel" Grid.Row="2" Visibility="Collapsed" IsVisibleChanged="ModsPanel_IsVisibleChanged"
              AllowDrop="True" Background="Transparent"
              DragEnter="ModsDrop_DragOver" DragOver="ModsDrop_DragOver" DragLeave="ModsDrop_DragLeave" Drop="ModsDrop_Drop">
            <!-- Installed mods/plugins + library items that fit this server (ServerModsTabViewModel).
                 For Minecraft only jars matching the variant and MC version are offered. -->
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding SupportsMods, Converter={StaticResource BoolToVis}}">
                <Border.Resources>
                    <DataTemplate x:Key="ModTagsTemplate">
                        <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrandAccentDarkBrush}" CornerRadius="4" Padding="6,1" Margin="0,2,6,0">
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource BrandAccentBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </Border.Resources>
                <Grid DataContext="{Binding ModsTab}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="Mods &amp; Plugins" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="Tip: drag mod or plugin files from Explorer onto this tab to install them." Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" Margin="0,2,0,0" Visibility="{Binding HasNotice, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="Loading…" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"
                                       Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Refresh" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
                            <Button Content="Mod Library" Style="{StaticResource GhostButtonStyle}" Click="ModsLink_Click" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding Notice}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                               Margin="0,14,0,0" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Installed on this server" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="Nothing installed yet." Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                       Visibility="{Binding IsInstalledEmpty, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Installed}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ServerModRowViewModel}">
                                        <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <!-- Double-click a folder (plugin data) to open it in the File Manager. -->
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick"
                                                              Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ModTagsTemplate}" />
                                                    <TextBlock Text="{Binding Reason}" Foreground="{StaticResource DangerBrush}" FontSize="11"
                                                               TextWrapping="Wrap" Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Open" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                                                            ToolTip="Show this folder in the File Manager"
                                                            Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Remove" Style="{StaticResource GhostButtonStyle}"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- One-click Minecraft mod/plugin install from Modrinth's public API. -->
                            <StackPanel DataContext="{Binding Modrinth}" Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                                <TextBlock Text="Browse Modrinth" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="ModrinthSearchBox_KeyDown" />
                                    <Button Grid.Column="1" Content="Search" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}"
                                            Command="{Binding SearchCommand}" IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBool}}" />
                                </Grid>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ModrinthResultViewModel}">
                                            <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="4" ClipToBounds="True"
                                                            Background="{StaticResource RootBackgroundBrush}" Margin="0,0,10,0">
                                                        <Image Source="{Binding IconUrl, Converter={StaticResource UrlToBitmap}}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DownloadsText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" VerticalAlignment="Center"
                                                            IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBool}}"
                                                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                                                <Setter Property="Content" Value="Install" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                                        <Setter Property="Content" Value="Installing…" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                        <Setter Property="Content" Value="Installed ✓" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- One-click Vintage Story mod install from mods.vintagestory.at's public API. -->
                            <StackPanel DataContext="{Binding VsMods}" Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                                <TextBlock Text="Browse mods.vintagestory.at" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" KeyDown="VsModsSearchBox_KeyDown" />
                                    <Button Grid.Column="1" Content="Search" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}"
                                            Command="{Binding SearchCommand}" IsEnabled="{Binding IsSearching, Converter={StaticResource InverseBool}}" />
                                </Grid>
                                <TextBlock Text="{Binding ServerVersionLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ServerVersionLabel, Converter={StaticResource NullToCollapsed}}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <!-- Fixed-height + its own scrollbar so a large result set scrolls independently
                                     (infinite-scroll feel) instead of stretching the whole page; VirtualizingStackPanel
                                     keeps only the visible cards realized, and each card's Loaded event lazily fetches
                                     its latest-version/compatibility badge only once it's actually scrolled into view. -->
                                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                    <ItemsControl ItemsSource="{Binding Results}" Focusable="False" VirtualizingStackPanel.IsVirtualizing="True"
                                                  VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:VsModCardViewModel}">
                                                <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                                        Loaded="VsModCard_Loaded">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" CornerRadius="4" ClipToBounds="True"
                                                                Background="{StaticResource RootBackgroundBrush}" Margin="0,0,10,0">
                                                            <Image Source="{Binding LogoUrl, Converter={StaticResource UrlToBitmap}}" Stretch="UniformToFill" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding DownloadsText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                                                <TextBlock Text="{Binding LatestVersionText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="8,0,0,0"
                                                                           Visibility="{Binding LatestVersionText, Converter={StaticResource NullToCollapsed}}" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding CompatStatusText}" FontSize="11" Margin="0,2,0,0"
                                                                       Visibility="{Binding CompatStatusText, Converter={StaticResource NullToCollapsed}}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompatWarning}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" VerticalAlignment="Center"
                                                                IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBool}}"
                                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                                                    <Setter Property="Content" Value="Install" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                                            <Setter Property="Content" Value="Installing…" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                            <Setter Property="Content" Value="Installed ✓" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <Grid Margin="0,16,0,6">
                                <TextBlock Text="Available from your library" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <CheckBox Content="Show incompatible" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"
                                          IsChecked="{Binding ShowIncompatible, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Text="{Binding HiddenText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                            <TextBlock Text="No compatible mods in your library. Import some on the Mod Library page."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding IsAvailableEmpty, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Available}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ServerModRowViewModel}">
                                        <Border Background="{StaticResource PanelBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompatible}" Value="False">
                                                            <Setter Property="Opacity" Value="0.55" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ModTagsTemplate}" />
                                                    <TextBlock Text="{Binding Reason}" Foreground="{StaticResource DangerBrush}" FontSize="11"
                                                               TextWrapping="Wrap" Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Install" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center"
                                                        IsEnabled="{Binding IsCompatible}"
                                                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SupportsMods}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="This game does not support mods" Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="SemiBold" VerticalAlignment="Top" />
            </Border>
            <Border x:Name="ModsDropOverlay" Style="{StaticResource DropOverlayStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" Style="{StaticResource IconTextStyle}" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{StaticResource BrandAccentBrush}" />
                    <TextBlock Text="Drop to install on this server" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding ModsTab.Summary}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="520" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="#990B1020" CornerRadius="8" Visibility="{Binding ModsTab.IsInstallingDrop, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Installing…" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>
        </Grid>

        <!-- Resources -->
        <Grid x:Name="ResourcesPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <UniformGrid Grid.Row="0" Columns="4">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="CPU Usage" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding CpuText}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Memory" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding RamText}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="Uptime" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding UptimeText}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Players" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding PlayersText}" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Connection" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- txAdmin -->
        <Grid x:Name="TxAdminPanel" Grid.Row="2" Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <wv2:WebView2 x:Name="TxAdminWeb" Visibility="Collapsed" />
                    <StackPanel x:Name="TxAdminPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxAdminStatusText" Text="Start the server to open the txAdmin console"
                                   FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" TextAlignment="Center" />
                        <TextBlock Text="txAdmin runs on 127.0.0.1:40120 — the first-run setup PIN is printed in the Console tab."
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   Margin="0,0,0,12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                        <Button Content="Open txAdmin in Browser" Style="{StaticResource GhostButtonStyle}"
                                HorizontalAlignment="Center" Command="{Binding OpenTxAdminInBrowserCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Klei Token (Don't Starve Together): paste box on top, Klei account site embedded below
             so the user can sign in, open Game Servers and copy the cluster token. -->
        <Grid x:Name="KleiPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Klei cluster token" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Sign in below, open Games › Don't Starve Together › Game Servers, add a new server and copy its token. Paste it here and save."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding KleiToken, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        <Button Grid.Column="1" Content="Save token" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SaveKleiTokenCommand}" />
                        <Button Grid.Column="2" Content="Open in Browser" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding OpenKleiInBrowserCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding KleiTokenStatus}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasKleiToken}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <wv2:WebView2 x:Name="KleiWeb" Visibility="Collapsed" />
                    <TextBlock x:Name="KleiWebStatus" Text="Loading the Klei account page…" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- Resource Pack (Minecraft Java) and LuckPerms: self-contained tab controls. -->
        <tabs:ResourcePackTab x:Name="ResourcePackPanel" Grid.Row="2" Visibility="Collapsed" DataContext="{Binding ResourcePack}" />
        <tabs:LuckPermsTab x:Name="LuckPermsPanel" Grid.Row="2" Visibility="Collapsed" DataContext="{Binding LuckPerms}" />
        <tabs:ScenarioDownloaderTab x:Name="ScenariosPanel" Grid.Row="2" Visibility="Collapsed" DataContext="{Binding Scenarios}" />

        <!-- Server Settings -->
        <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource CardStyle}" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="Description" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SettingDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Port" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SettingPort, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Text="RAM Min (MB)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SettingRamMin, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="RAM Max (MB)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SettingRamMax, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Start Command" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SettingStartCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" Margin="0,0,0,12" />
                    <TextBlock Text="Stop Command (stdin)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SettingStopCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,0,0,8" />
                    <CheckBox Content="Restart automatically when the server crashes" Foreground="{StaticResource TextSecondaryBrush}"
                              IsChecked="{Binding SettingAutoRestart}" Margin="0,4,0,16" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save Changes" Style="{StaticResource AccentButtonStyle}" Width="140"
                                Command="{Binding SaveSettingsCommand}" />
                        <Button Content="Delete Server" Width="140" Margin="10,0,0,0" Command="{Binding DeleteServerCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
