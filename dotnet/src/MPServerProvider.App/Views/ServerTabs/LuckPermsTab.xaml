<UserControl x:Class="MPServerProvider.App.Views.ServerTabs.LuckPermsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status + actions -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE72E;" Style="{StaticResource IconTextStyle}" FontSize="16" VerticalAlignment="Center"
                           Foreground="{StaticResource BrandAccentBrush}" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LuckPerms" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding JarName}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <Border CornerRadius="8" Padding="6,1" Margin="8,0,0,0" Background="{StaticResource SuccessBrush}" VerticalAlignment="Center"
                                Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}"
                                ToolTip="The editor is connected to the server: Save applies changes immediately">
                            <TextBlock Text="LIVE" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                    <Button Padding="12,6" Margin="0,0,8,0" Command="{Binding TrustEditorCommand}"
                            Visibility="{Binding HasTrustNonce, Converter={StaticResource BoolToVis}}"
                            ToolTip="Run lp trusteditor so this editor can apply changes live">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                <Setter Property="Foreground" Value="Black" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D7;" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Trust editor" />
                        </StackPanel>
                    </Button>
                    <Button Padding="12,6" Margin="0,0,8,0" Command="{Binding ApplyChangesCommand}"
                            Visibility="{Binding HasApplyCode, Converter={StaticResource BoolToVis}}"
                            ToolTip="Run lp applyedits with the code the editor generated">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Apply changes" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}" Padding="12,6" Margin="0,0,8,0" Command="{Binding OpenEditorCommand}"
                            ToolTip="Runs lp editor on the server and opens the editor here">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Open editor" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEditorUrl}" Value="True">
                                                <Setter Property="Text" Value="New session" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsWaitingForLink}" Value="True">
                                                <Setter Property="Text" Value="Waiting…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButtonStyle}" Padding="10,6" Margin="0,0,8,0" Command="{Binding CopyLinkCommand}"
                            IsEnabled="{Binding HasEditorUrl}" ToolTip="Copy the editor link">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Copy link" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButtonStyle}" Padding="10,6" Command="{Binding OpenInBrowserCommand}"
                            IsEnabled="{Binding HasEditorUrl}" ToolTip="Open the editor in your web browser instead">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource IconTextStyle}" FontSize="12" Margin="0,0,6,0" />
                            <TextBlock Text="Open in browser" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Editor -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />
                <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480" Margin="20">
                    <TextBlock x:Name="PlaceholderTitle" Text="LuckPerms web editor" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="PlaceholderText" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Open editor runs lp editor on the running server and shows the editor here. Edit groups, users and permissions, then press Save in the editor: changes apply live when the editor is connected, otherwise use Apply changes." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
