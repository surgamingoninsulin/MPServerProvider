<UserControl x:Class="MPServerProvider.App.Views.ServerTabs.ScenarioDownloaderTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MPServerProvider.App.Controls"
             xmlns:conv="clr-namespace:MPServerProvider.App.Converters"
             xmlns:vm="clr-namespace:MPServerProvider.App.ViewModels">
    <UserControl.Resources>
        <controls:UrlToBitmapConverter x:Key="UrlToBitmap" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Scenario Downloader" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Import game data…" Style="{StaticResource GhostButtonStyle}" Command="{Binding ImportGameDataCommand}" />
                <Button Content="Open on rctgo.com" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding OpenOnWebsiteCommand}" />
                <Button Content="Refresh" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Scenarios}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScenarioCardViewModel}">
                            <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,12,12">
                                <StackPanel>
                                    <Border Background="{StaticResource PanelBackgroundBrush}" Height="130" CornerRadius="6" ClipToBounds="True">
                                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource UrlToBitmap}}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Margin="0,2,0,8" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                        <Run Text="by " /><Run Text="{Binding Author, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button HorizontalAlignment="Stretch" IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}"
                                            Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                                <Setter Property="Content" Value="Download" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                        <Setter Property="Content" Value="Downloading…" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                                        <Setter Property="Content" Value="Downloaded ✓" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,16">
                    <Button Content="‹ Previous page" Style="{StaticResource GhostButtonStyle}" Command="{Binding PreviousPageCommand}" />
                    <TextBlock Text="{Binding Page}" VerticalAlignment="Center" Margin="12,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Button Content="Next page ›" Style="{StaticResource GhostButtonStyle}" Command="{Binding NextPageCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
